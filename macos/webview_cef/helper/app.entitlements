<?xml version="1.0" encoding="UTF-8"?>
<!-- Entitlements the *host app* needs for embedded CEF (V8 JIT + loading the
     CEF framework). Merge into the app's existing entitlements. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Scope note: disable-library-validation lets the host process load the
	     separately-signed CEF framework, but it relaxes dylib-injection
	     protection for the WHOLE host process, not just CEF. This is the standard
	     CEF-on-macOS requirement and can't be narrowed further; it is also
	     incompatible with Mac App Store distribution (fine for Developer-ID). -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
